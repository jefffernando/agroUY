---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/content';
import { categoryBySlug } from '../config/categories';
interface Props { article: CollectionEntry<'articles'> }
const { article } = Astro.props;
---
<article class="featured">
 <img src={url(article.data.image)} width="1200" height="720" alt="Ilustración editorial de un paisaje productivo" fetchpriority="high"/>
 <div class="featured-content"><span class="pill">{categoryBySlug(article.data.category).name} · GUÍA DESTACADA</span><h2><a href={url('articulos/'+article.id+'/')}>{article.data.title}</a></h2><p>{article.data.description}</p><a class="text-link" href={url('articulos/'+article.id+'/')}>Leer la guía <span>↗</span></a></div>
</article>
